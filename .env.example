DATABASE_URL=postgres://spanish_coach:spanish_coach@localhost:5432/spanish_coach
APP_VERSION=development
DEPLOYMENT_VERSION=
LOG_LEVEL=info

# Optional local Piper sidecar. If absent, listening uses the browser's es-ES
# speech synthesis voice and does not claim server-side audio caching.
PIPER_EXECUTABLE=
PIPER_MODEL_PATH=
PIPER_MODEL_CONFIG_PATH=
PIPER_VOICE_ID=es_ES-davefx-medium
TTS_CACHE_DIR=.data/tts-cache
